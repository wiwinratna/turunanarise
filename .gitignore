/node_modules
/frontend/node_modules
/frontend/dist
/frontend/.env
/frontend/.env.*.local

# Laravel Backend is usually handled by its own .gitignore in /backend
# but we can add some root-level ignores just in case
/backend/vendor
/backend/.env
/backend/public/storage
/backend/public/hot
/backend/storage/*.key
/backend/storage/framework/cache
/backend/storage/framework/sessions
/backend/storage/framework/testing
/backend/storage/framework/views
/backend/storage/logs

# OS generated files
.DS_Store
Thumbs.db
